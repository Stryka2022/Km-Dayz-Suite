<UserControl x:Class="Dzl.Tray.Views.RemoteFilesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        MinWidth="760" MinHeight="500">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Saved endpoint / connection bar. FTP and RCon secrets are DPAPI-protected separately. -->
    <Border Grid.Row="0" CornerRadius="8" Padding="14" Margin="0,0,0,12"
            Background="{DynamicResource KmPanelBrush}"
            BorderBrush="{DynamicResource KmLineBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.4*" />
          <ColumnDefinition Width="1.4*" />
          <ColumnDefinition Width="1.4*" />
          <ColumnDefinition Width="1.4*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,12">
          <Border Width="40" Height="40" CornerRadius="8" Margin="0,0,10,0"
                  Background="{DynamicResource KmGreenTintBrush}" BorderBrush="{DynamicResource KmGreenBrush}" BorderThickness="1">
            <ui:SymbolIcon Symbol="Server24" FontSize="21" Foreground="{DynamicResource KmGreenBrush}" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="APH HAVOC REMOTE ADMIN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource KmOrangeBrush}" />
            <TextBlock Text="FTP / FTPS + BattlEye RCon" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Manage server files and live administration without leaving KM Suite."
                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <ui:Button Content="New" Margin="0,0,8,0" Click="OnNewProfile" />
          <ui:Button Content="Save profile" Margin="0,0,8,0" Click="OnSaveProfile" />
          <ui:Button Content="Delete" Appearance="Danger" Click="OnDeleteProfile" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
          <TextBlock Text="Saved profile" Style="{StaticResource FieldLabel}" />
          <ComboBox x:Name="ProfileBox" DisplayMemberPath="Name" SelectionChanged="OnProfileSelected" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
          <TextBlock Text="Profile name" Style="{StaticResource FieldLabel}" />
          <ui:TextBox x:Name="NameBox" PlaceholderText="Production server" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,8">
          <TextBlock Text="Linked server instance" Style="{StaticResource FieldLabel}" />
          <ComboBox x:Name="InstanceBox" ToolTip="Links player checks and update warnings to this KM Suite instance" />
        </StackPanel>
        <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Text="Both passwords are encrypted for this Windows user. Leave a saved password blank to keep it."
                   TextWrapping="Wrap" VerticalAlignment="Center" FontSize="11"
                   Foreground="{DynamicResource KmGreenBrush}" />

        <TabControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,2,0,0">
          <TabItem Header="FTP / FTPS FILES">
            <Grid Margin="0,8,0,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="86" /><ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Text="FTP host / IP" Style="{StaticResource FieldLabel}" />
                <ui:TextBox x:Name="HostBox" PlaceholderText="ftp.example.com or 203.0.113.10" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
                <TextBlock Text="FTP port" Style="{StaticResource FieldLabel}" />
                <ui:TextBox x:Name="PortBox" Text="21" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,8">
                <TextBlock Text="Protocol" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ProtocolBox" SelectedIndex="0">
                  <ComboBoxItem Content="FTPS · Explicit TLS" />
                  <ComboBoxItem Content="FTP · Plain" />
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,8,8">
                <TextBlock Text="FTP username" Style="{StaticResource FieldLabel}" />
                <ui:TextBox x:Name="UserBox" PlaceholderText="server owner" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,8,8" MinWidth="150">
                <TextBlock Text="FTP password" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordBox" Padding="9,6" ToolTip="Leave blank to use the saved encrypted password" />
              </StackPanel>
              <ui:Button x:Name="ConnectButton" Grid.Row="0" Grid.Column="5" Content="Connect FTP"
                         Icon="{ui:SymbolIcon PlugConnected24}" Appearance="Primary" Padding="16,7"
                         VerticalAlignment="Bottom" Margin="0,0,0,8" Click="OnConnect" />
              <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,8,0">
                <TextBlock Text="Remote root" Style="{StaticResource FieldLabel}" />
                <ui:TextBox x:Name="RootBox" Text="/" PlaceholderText="/dayz/server" />
              </StackPanel>
              <CheckBox x:Name="PassiveBox" Grid.Row="1" Grid.Column="4" Content="Passive mode" IsChecked="True"
                        VerticalAlignment="Bottom" Margin="0,0,8,8" />
            </Grid>
          </TabItem>

          <TabItem Header="BATTLEYE RCON">
            <Grid Margin="0,8,0,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="70" /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Text="RCon host / IP" Style="{StaticResource FieldLabel}" />
                <ui:TextBox x:Name="RconHostBox" PlaceholderText="Blank uses the FTP host" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
                <TextBlock Text="RCon port" Style="{StaticResource FieldLabel}" />
                <ui:TextBox x:Name="RconPortBox" Text="2301" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,8" MinWidth="180">
                <TextBlock Text="RCon password" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="RconPasswordBox" Padding="9,6" ToolTip="The RConPassword value from BEServer_x64.cfg" />
              </StackPanel>
              <ui:Button x:Name="RconConnectButton" Grid.Row="0" Grid.Column="3" Content="Connect RCon"
                         Appearance="Primary" Padding="16,7" VerticalAlignment="Bottom" Margin="0,0,8,8"
                         Click="OnConnectRcon" />
              <ui:Button x:Name="RconDisconnectButton" Grid.Row="0" Grid.Column="4" Content="Disconnect"
                         Padding="12,7" VerticalAlignment="Bottom" Margin="0,0,0,8" IsEnabled="False"
                         Click="OnDisconnectRcon" />

              <ui:TextBox x:Name="RconCommandBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                          PlaceholderText="players, commands, say -1 message…" KeyDown="OnRconCommandKeyDown" Margin="0,0,8,8" />
              <ui:Button Grid.Row="1" Grid.Column="2" Content="Send command" Margin="0,0,8,8" Click="OnSendRcon" />
              <ui:Button Grid.Row="1" Grid.Column="3" Content="Players" Margin="0,0,8,8" Tag="players" Click="OnRconQuickCommand" />
              <ui:Button Grid.Row="1" Grid.Column="4" Content="Commands" Margin="0,0,0,8" Tag="commands" Click="OnRconQuickCommand" />

              <TextBox x:Name="RconConsoleBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                       IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                       Padding="8" Background="{DynamicResource KmInputBrush}"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       BorderBrush="{DynamicResource KmLineBrush}" BorderThickness="1" />
              <TextBlock Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,8,6" IsHitTestVisible="False" Text="Native BattlEye UDP · use a trusted network or VPN"
                         FontSize="10" Foreground="{DynamicResource KmOrangeBrush}" />
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>

    <!-- Remote tree/list and inline text editor. -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.9*" MinWidth="330" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="1.1*" MinWidth="390" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" CornerRadius="8" Padding="12"
              Background="{DynamicResource KmPanelBrush}" BorderBrush="{DynamicResource KmLineBrush}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Content="Up" Margin="0,0,8,0" Click="OnUp" />
            <ui:TextBox x:Name="PathBox" Grid.Column="1" Text="/" KeyDown="OnPathKeyDown" />
            <ui:Button Grid.Column="2" Content="Go" Margin="8,0,0,0" Click="OnGoPath" />
          </Grid>
          <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,2">
            <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,6,0" Click="OnRefresh" />
            <ui:Button Content="New folder" Margin="0,0,6,0" Click="OnNewFolder" />
            <ui:Button Content="Upload" Margin="0,0,6,0" Click="OnUpload" />
            <ui:Button Content="Download" Margin="0,0,6,0" Click="OnDownload" />
            <ui:Button Content="Rename" Margin="0,0,6,0" Click="OnRename" />
            <ui:Button Content="Delete" Appearance="Danger" Click="OnDeleteRemote" />
          </WrapPanel>
          <DataGrid x:Name="RemoteGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                    SelectionMode="Single" MouseDoubleClick="OnRemoteDoubleClick"
                    Style="{StaticResource DarkDataGrid}"
                    ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeader}"
                    RowStyle="{StaticResource DarkDataGridRow}"
                    CellStyle="{StaticResource DarkDataGridCell}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="150" />
              <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="70" />
              <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="80" />
              <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedLabel}" Width="125" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="3" x:Name="EntryCountText" Text="Connect to browse server files"
                     Margin="2,8,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>
      </Border>

      <Border Grid.Column="2" CornerRadius="8" Padding="12"
              Background="{DynamicResource KmPanelBrush}" BorderBrush="{DynamicResource KmLineBrush}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="INLINE CONFIG EDITOR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource KmOrangeBrush}" />
              <TextBlock x:Name="EditorTitle" Text="Select a text, XML, JSON or config file" FontSize="16" FontWeight="SemiBold" />
            </StackPanel>
            <Border x:Name="DirtyBadge" Grid.Column="1" Visibility="Collapsed" CornerRadius="10" Padding="9,3" Margin="8,0"
                    VerticalAlignment="Center" Background="{DynamicResource KmOrangeTintBrush}" BorderBrush="{DynamicResource KmOrangeBrush}" BorderThickness="1">
              <TextBlock Text="UNSAVED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource KmOrangeBrush}" />
            </Border>
            <ui:Button x:Name="SaveRemoteButton" Grid.Column="2" Content="Save to server" Appearance="Primary"
                       IsEnabled="False" Click="OnSaveRemote" />
          </Grid>
          <TextBox x:Name="EditorBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                   TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                   Padding="12" Background="{DynamicResource KmInputBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   BorderBrush="{DynamicResource KmLineBrush}" BorderThickness="1" IsEnabled="False"
                   TextChanged="OnEditorTextChanged" />
          <TextBlock Grid.Row="2" Text="A local recovery copy is created before every remote overwrite. Binary files are download-only."
                     Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,9,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <ProgressBar x:Name="BusyBar" Grid.Column="0" Width="90" Height="3" IsIndeterminate="True" Visibility="Collapsed"
                   Foreground="{DynamicResource KmGreenBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
      <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <Border x:Name="RemoteOsBadge" Grid.Column="2" CornerRadius="10" Padding="9,3" Margin="8,0"
              Background="{DynamicResource KmGreenTintBrush}" BorderBrush="{DynamicResource KmGreenBrush}" BorderThickness="1"
              Visibility="Collapsed">
        <TextBlock x:Name="RemoteOsText" Text="REMOTE OS: UNKNOWN" FontSize="10" FontWeight="Bold"
                   Foreground="{DynamicResource KmGreenBrush}" />
      </Border>
      <TextBlock Grid.Column="3" Text="FTP + RCon credentials: Windows DPAPI protected" FontSize="11" Foreground="{DynamicResource KmGreenBrush}" />
    </Grid>
  </Grid>
</UserControl>
