<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- KM Suite palette. These keys deliberately override Wpf.Ui's stock blue/grey dark
         theme after its dictionaries are loaded in App.xaml. This keeps every companion
         page visually consistent with the proprietary host while the GPL process remains
         technically and legally separate. -->
    <SolidColorBrush x:Key="KmCanvasBrush" Color="#050706" />
    <SolidColorBrush x:Key="KmPanelBrush" Color="#0D110E" />
    <SolidColorBrush x:Key="KmPanelSoftBrush" Color="#121812" />
    <SolidColorBrush x:Key="KmInputBrush" Color="#080B09" />
    <SolidColorBrush x:Key="KmLineBrush" Color="#263427" />
    <SolidColorBrush x:Key="KmGreenBrush" Color="#35F25B" />
    <SolidColorBrush x:Key="KmGreenTintBrush" Color="#33173A20" />
    <SolidColorBrush x:Key="KmOrangeBrush" Color="#FF7A1A" />
    <SolidColorBrush x:Key="KmOrangeTintBrush" Color="#33281A10" />

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#050706" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F2FFF7" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9EB2A4" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#708477" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#55705D" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#35F25B" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF7A1A" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#050706" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#07110A" />

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#35F25B" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#25C848" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#1FA33C" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#24522E" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#172018" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#203322" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#281A10" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#101611" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#080B09" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#9EB2A4" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#0D110E" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#20172018" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#33203322" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#30402F" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#263427" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#263427" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#273328" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#263427" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#263427" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0D110E" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#121812" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#0D110E" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#121812" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#050706" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#0D110E" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#121812" />
    <SolidColorBrush x:Key="MicaBackgroundFillColorBaseBrush" Color="#050706" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#35F25B" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FF7A1A" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF4646" />

    <!-- "On" / active accents -->
    <SolidColorBrush x:Key="FlagActiveBrush" Color="#35F25B" />   <!-- CE flag glyph: active -->
    <SolidColorBrush x:Key="StatusUpBrush" Color="#35F25B" />     <!-- status dot: up / online -->

    <!-- "Off" / muted greys -->
    <SolidColorBrush x:Key="FlagMutedBrush" Color="#555B63" />    <!-- CE flag glyph: inactive -->
    <SolidColorBrush x:Key="StatusDownBrush" Color="#6E6E6E" />   <!-- status dot: down / offline -->

    <!-- Mission-source health dot (dashboard "Mission source" card) -->
    <SolidColorBrush x:Key="MissionOkBrush" Color="#35F25B" />    <!-- loads the instance's mission -->
    <SolidColorBrush x:Key="MissionWarnBrush" Color="#FF7A1A" /> <!-- loads the install's mission -->
    <SolidColorBrush x:Key="MissionErrorBrush" Color="#FF4646" /> <!-- mission folder missing -->

    <!-- CE "active row" highlight — the single source of truth for the selected/hover look shared by the
         Dictionaries ListBox rows AND every Central-Economy DataGrid row, so the active row is identical on
         every CE tab. Change the colour here, not per-tab. -->
    <SolidColorBrush x:Key="CeRowSelectedBrush" Color="#173A20" />   <!-- selected: KM green tint -->
    <SolidColorBrush x:Key="CeRowHoverBrush" Color="#20203322" />    <!-- hover: green wash -->
    <SolidColorBrush x:Key="CeAccentBarBrush" Color="#35F25B" />     <!-- left accent bar on the nav-rail selection -->

</ResourceDictionary>
